{
  "name": "project-crt",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --filter @tlannigan/crt build && pnpm --parallel --filter @tlannigan/crt --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "check-types": "pnpm -r check-types",
    "test": "pnpm -r test",
    "storybook": "pnpm --filter @tlannigan/crt storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
